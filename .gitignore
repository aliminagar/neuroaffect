# Data (datasets, frames, model outputs, heavy artifacts) — never commit.
# Keep the directory (via .gitkeep) but ignore everything else inside it.
data/*
!data/.gitkeep

# Virtual environments
.venv/
.venv-dev/
venv/
env/

# Python caches / build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
